# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Required in production (minimum 32 random characters; e.g. openssl rand -hex 32)
SESSION_SECRET=""

# ALLOW_DEMO_LOGIN: Set to "true" ONLY if you intentionally want demo sandbox accounts enabled in production
ALLOW_DEMO_LOGIN="false"

# DB_DRIVER: "auto" | "postgres" | "sqlite"
# In production, PostgreSQL is used automatically when SQL_HOST is configured; set DB_DRIVER="sqlite" only if explicitly desired.
DB_DRIVER="auto"

# Google Maps Platform API Keys (split public client vs private server keys)
# Restrict VITE_GOOGLE_MAPS_API_KEY in Google Cloud Console by HTTP referrer to your domain + Maps JavaScript/Places/Routes APIs only.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
# Restrict GOOGLE_MAPS_API_KEY by server IP/cloud environment + Places/Geocoding web service APIs only (never exposed to clients).
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Cloud SQL (PostgreSQL) runtime & schema management variables (injected by Cloud SQL integration)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="app_db"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Optional external email/SMS notification providers (Gmail Workspace OAuth works natively without these)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LIFE-LINE AI <alerts@lifeline-ai.app>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional public support email shown when Google OAuth is in Testing mode
DEVELOPER_CONTACT_EMAIL=""

# Optional comma-separated origins allowed for CORS requests (defaults to APP_URL + same-origin)
CORS_ALLOWED_ORIGINS=""

